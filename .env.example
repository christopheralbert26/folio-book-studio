# Runtime values belong in Sites secret settings, never in source or VITE_* variables.
LULU_CLIENT_KEY=
LULU_CLIENT_SECRET=
LULU_ENVIRONMENT=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FILE_SIGNING_SECRET=
PRINT_CONTACT_EMAIL=
# JSON array of manually verified paperback profiles. See docs/OPERATIONS.md.
LULU_PROFILES_JSON=[]
# Keep these false until each corresponding integration has actually passed testing.
EXTERNAL_DELIVERY_VERIFIED=false
SANDBOX_ORDER_VERIFIED=false
PHYSICAL_PROOF_VERIFIED=false
OPERATIONS_VERIFIED=false
CHECKOUT_ENABLED=false
# DB and BUCKET are provisioned bindings declared in .openai/hosting.json.

# SHA-256 account namespace of the shop owner; never accepted from browser input.
SUPPORT_OWNER_HASH=
